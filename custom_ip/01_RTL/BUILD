# exported here so the Chisel BlackBox shim (hdl/chisel/src/bus/CnnAccel.scala) can
# pull it in via addResource when the SoC is emitted. CoralNPUChiselSubsystem.sv is
# GENERATED into this folder by ../build_coralnpu.sh (not checked in).
exports_files(["CnnAccel.sv"])
